# TapCard Production Environment Variables
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL (Used for generating NFC Short URLs and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Dedicated Short Domain for NFC Card writing (e.g., https://tapcard.in)
NEXT_PUBLIC_NFC_BASE_URL=https://tapcard.in

# Optional: Payment Gateway Keys (Abstraction ready for Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
